# NOTE: this is an addition to .env file, not a standalone file !
# It should be loaded with: source env/setenv.sh <env>

# Docker Compose project & profile
COMPOSE_PROJECT_NAME=po_off
COMPOSE_PROFILES=off

# App & Domain Settings
PRODUCT_OPENER_DOMAIN=openfoodfacts.localhost
PRODUCT_OPENER_PORT=80
PRODUCT_OPENER_HOST_PORT=80
PRODUCT_OPENER_NETWORK=product-opener

# Flavor definition
PRODUCT_OPENER_FLAVOR=openfoodfacts
PRODUCT_OPENER_FLAVOR_SHORT=off

# Datastores & Queues
MONGODB_DATABASE=off
POSTGRES_DB=minion
MINION_QUEUE=openfoodfacts.localhost
COMMON_NET_NAME=off_shared_network

# Containers specific configurations
APACHE_ENVVARS=/etc/apache2/off-envvars
NUTRIPATROL_URL=https://nutripatrol.openfoodfacts.org/

