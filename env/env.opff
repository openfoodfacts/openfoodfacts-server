# NOTE: this is an addition to .env file, not a standalone file !
# It should be loaded with: source env/setenv.sh <env>

# Docker Compose project & profile
COMPOSE_PROJECT_NAME=po_opff
COMPOSE_PROFILES=off

# App & Domain Settings
PRODUCT_OPENER_DOMAIN=openpetfoodfacts.localhost
PRODUCT_OPENER_PORT=83
PRODUCT_OPENER_HOST_PORT=83
PRODUCT_OPENER_NETWORK=po_opff_network

# Flavor definition
PRODUCT_OPENER_FLAVOR=openpetfoodfacts
PRODUCT_OPENER_FLAVOR_SHORT=opff

# Datastores & Queues
MONGODB_DATABASE=opff
POSTGRES_DB=minion_opff
MINION_QUEUE=openpetfoodfacts.localhost

# Containers specific configurations
APACHE_ENVVARS=/etc/apache2/off-envvars
NUTRIPATROL_URL=https://nutripatrol.openfoodfacts.org/
