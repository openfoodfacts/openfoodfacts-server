# NOTE: this is an addition to .env file, not a standalone file !
# It should be loaded with: source env/setenv.sh <env>

# Docker Compose project & profile
COMPOSE_PROJECT_NAME=po_opf
COMPOSE_PROFILES=off

# App & Domain Settings
PRODUCT_OPENER_DOMAIN=openproductsfacts.localhost
PRODUCT_OPENER_PORT=82
PRODUCT_OPENER_HOST_PORT=82
PRODUCT_OPENER_NETWORK=po_opf_network

# Flavor definition
PRODUCT_OPENER_FLAVOR=openproductsfacts
PRODUCT_OPENER_FLAVOR_SHORT=opf

# Datastores & Queues
MONGODB_DATABASE=opf
POSTGRES_DB=minion
MINION_QUEUE=openproductsfacts.localhost
COMMON_NET_NAME=opf_shared_network

# Containers specific configurations
APACHE_ENVVARS=/etc/apache2/off-envvars
NUTRIPATROL_URL=https://nutripatrol.openfoodfacts.org/
