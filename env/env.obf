# NOTE: this is an addition to .env file, not a standalone file !
# It should be loaded with: source env/setenv.sh <env>

# Docker Compose project & profile
COMPOSE_PROJECT_NAME=po_obf
COMPOSE_PROFILES=off

# App & Domain Settings
PRODUCT_OPENER_DOMAIN=openbeautyfacts.localhost
PRODUCT_OPENER_PORT=81
PRODUCT_OPENER_HOST_PORT=81
PRODUCT_OPENER_NETWORK=po_obf_network

# Flavor definition
PRODUCT_OPENER_FLAVOR=openbeautyfacts
PRODUCT_OPENER_FLAVOR_SHORT=obf

# Datastores & Queues
MONGODB_DATABASE=obf
POSTGRES_DB=minion
MINION_QUEUE=openbeautyfacts.localhost
COMMON_NET_NAME=obf_shared_network

# Containers configuration
APACHE_ENVVARS=/etc/apache2/off-envvars
ROBOTOFF_URL=https://robotoff.openfoodfacts.org
NUTRIPATROL_URL=https://nutripatrol.openfoodfacts.org/
