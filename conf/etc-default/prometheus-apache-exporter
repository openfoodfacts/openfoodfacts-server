# Set the command-line arguments to pass to the server.
# Note: since Debian trixie, flags must use the --flag=value form
# (single-dash long flags like -scrape_uri are rejected)
ARGS='--scrape_uri=http://127.0.0.1:8001/server-status/?auto'

# Main options of prometheus-apache-exporter (see --help for the full list):
#  --scrape_uri="http://localhost/server-status/?auto"
#      URI to apache stub status page.
#  --host_override=""
#      Override for HTTP Host header; empty string for no override.
#  --insecure
#      Ignore server certificate if using https.
#  --telemetry.endpoint="/metrics"
#      Path under which to expose metrics.
#  --web.listen-address=:9117
#      Addresses on which to expose metrics and web interface.
