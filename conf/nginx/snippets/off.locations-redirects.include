location = /dijh-po-open-food-facts {
	try_files /donate/wa.html =404;
}

# Wolof (WO)
location = /saraxle-open-food-facts {
	try_files /donate/wo.html =404;
}

# Yiddish (YI)
location = /bayshteyer-tsu-open-food-facts {
	try_files /donate/yi.html =404;
}

# Zeelandic (ZEA)
location = /geef-an-open-food-facts {
	try_files /donate/zea.html =404;
}

# === end donation redirects ===

location = /hunger-game {
	return 301 https://hunger.openfoodfacts.org;
}

# old page Redirect
location = /donate {
	return 301 https://$host/donate-to-open-food-facts;
}

