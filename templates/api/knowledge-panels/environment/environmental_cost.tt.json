[% IF panel.unit == 'ml' %][% SET per_100_key = 'f_environmental_cost_for_100ml' %][% SET per_100_column_key = 'environmental_cost_points_for_100ml' %][% ELSE %][% SET per_100_key = 'f_environmental_cost_for_100g' %][% SET per_100_column_key = 'environmental_cost_points_for_100g' %][% END %]
{
    "level": "info",
    "topics": ["environment"],
    "title_element": {
        "title": [% lang('environmental_cost_title') | js %],
        "subtitle": [% IF panel.has_per_product %][% (f_lang('f_environmental_cost_for_product', { 'points' => panel.ecs_per_product, 'quantity' => panel.quantity }) _ ' - ' _ f_lang(per_100_key, { 'points' => panel.ecs_per_100 })) | js %][% ELSE %][% f_lang(per_100_key, { 'points' => panel.ecs_per_100 }) | js %][% END %]
    },
    "elements": [
        {
            "element_type": "text",
            "text_element": {
                "html": [% lang('environmental_cost_description') | js %]
            }
        },
        {
            "element_type": "table",
            "table_element": {
                "id": "environmental_cost_breakdown",
                "table_type": "default",
                "title": [% lang('ecs_breakdown') | js %],
                "columns": [
                    {
                        "text": [% lang('environmental_cost_stage') | js %],
                        "type": "text"
                    },
                    [% IF panel.has_per_product %]
                    {
                        "text": [% f_lang('f_environmental_cost_points_for_product', { 'quantity' => panel.quantity }) | js %],
                        "type": "text"
                    },
                    [% END %]
                    {
                        "text": [% lang(per_100_column_key) | js %],
                        "type": "text"
                    }
                ],
                "rows": [
                    [% FOREACH row IN panel.rows %]
                    {
                        "values": [
                            { "text": [% lang(row.label) | js %] },
                            [% IF panel.has_per_product %]{ "text": "[% row.per_product %]" },[% END %]
                            { "text": "[% row.per_100 %]" }
                        ]
                    }[% UNLESS loop.last %],[% END %]
                    [% END %]
                ]
            }
        }
    ]
}
