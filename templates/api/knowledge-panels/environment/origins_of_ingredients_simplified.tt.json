{
    "level" :"info",
    "topics": [
        "environment"
    ],
    "expanded": false,
    "half_width_on_mobile": true,      
[% IF product.environmental_score_data.adjustments.origins_of_ingredients.warning == "origins_are_100_percent_unknown" %]
    "evaluation": "unknown",
    "title_element": {
        "name": [% lang('environmental_score_origins_of_ingredients') | js %],
        "value_string": [% lang('missing_data') | js %],
        "type": "string",
        "icon_color_from_evaluation": true,
        "icon_url": "[% static_subdomain %]/images/icons/dist/public.svg",
        "icon_size": "small",
    },
    "elements": [
        {
            "element_type": "text",
            "text_element": {
                "type": "warning",
                "html": `
                [% lang('environmental_score_ingredients_not_indicated') %]<br><br>
                [% lang('environmental_score_please_add_the_ingredients') %]<br><br>
                [% lang('environmental_score_platform_prompt_environmental_score_modal') %]
                    `
            }
        },
        {
            "element_type": "action",
            "action_element": {
                "html": `[% lang("action_add_origins") %]`,
                "actions": [
                    "add_origins",
                ]
            }
        },
    ],
[% ELSE %]
    [% IF product.environmental_score_data.adjustments.origins_of_ingredients.value <= 0 %]
    "evaluation": "bad",
    "title_element": {
        "value_string": [% lang('high_impact') | js %],
    [% ELSIF product.environmental_score_data.adjustments.origins_of_ingredients.value <= 15 %]
    "evaluation": "average",
    "title_element": {
        "value_string": [% lang('medium_impact') | js %]    ,
    [% ELSE %]
    "evaluation": "good",
    "title_element": {
        "value_string": [% lang('low_impact') | js %],
    [% END %]
        "name": [% lang('environmental_score_origins_of_ingredients') | js %],
        "type": "string",
        "icon_color_from_evaluation": true,
        "icon_url": "[% static_subdomain %]/images/icons/dist/public.svg",
        "icon_size": "small",
    },
    "elements": [    
        {
            "element_type": "table",
            "table_element": {
                "id": "environmental_score_origins_of_ingredients_table",
                "table_type": "percents",
                "title": [% lang('environmental_score_origins_of_ingredients') | js %],
                "columns": [
                    {
                        "text": [% lang('origin') | js %],
                        "type": "text",
                    },
                    {
                        "text": [% lang('percent_of_ingredients') | js %],
                        "type": "percent",
                    },
                    {
                        "text": [% lang('environmental_score_impact') | js %],
                        "type": "text",
                    }
                ],
                "rows": [
                    [% FOREACH origin IN product.environmental_score_data.adjustments.origins_of_ingredients.aggregated_origins %]
                    {
                        "values": [
                            {
                                "text": "[% display_taxonomy_tag_name("origins",origin.origin) %]",
                            },
                            {
                                "text": "[% round(origin.percent) %] %",
                                "percent": [% round(origin.percent) %],
                                // EPI bonus goes from -5 to 5 with the formula bonus = epi_score / 10 - 5
                                // Transportation bonus goes from 0 to 15 with the formula bonus = transportation_score * 0.15
                                [% SET score = origin.epi_score / 10 - 5 + origin.transportation_score * 0.15 %]
                                [% IF score >= 15 %]
                                    "evaluation": "good",
                                [% ELSIF score <= 0 %]
                                    "evaluation": "bad",
                                [% ELSE %]
                                    "evaluation": "neutral",
                                [% END %]                                
                            },
                            {
                                [% IF score >= 15 %]
                                    "text": [% lang('low') | ucfirst | js %],
                                    "evaluation": "good",
                                [% ELSIF score <= 0 %]
                                    "text": [% lang('high') | ucfirst | js %],
                                    "evaluation": "bad",
                                [% ELSE %]
                                    "text": [% lang('medium') | ucfirst | js %],
                                    "evaluation": "neutral",
                                [% END %]
                            }
                            ]
                    },
                    [% END %]
                ]
            }
        },
    ],
[% END %]
}
