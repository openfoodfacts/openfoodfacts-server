{
    "level" :"info",
    "topics": [
        "environment"
    ],    
[% IF not (product.environmental_score_data.adjustments.packaging.packagings && product.environmental_score_data.adjustments.packaging.packagings.size) %]
    "evaluation": "unknown",
    "title_element": {
        "title": [% lang('environmental_score_packaging_missing_information') | js %],
        "subtitle": [% (lang('malus') _ sep _ ': ' _ product.environmental_score_data.adjustments.packaging.value) | js %],
        "icon_color_from_evaluation": true,
        "icon_url": "[% static_subdomain %]/images/icons/dist/packaging.svg",
        "icon_size": "small",
    },
    "elements": [
        {
            "element_type": "text",
            "text_element": {
                "type": "warning",
                "html": `
                    [% lang('environmental_score_no_packaging_information') %]
                    `
            }
        }, 
[% ELSE %]
    [% IF product.environmental_score_data.adjustments.packaging.value <= -15 %]
    "evaluation": "bad",
    "title_element": {
        "title": [% lang('environmental_score_packaging_impact_high') | js %],
    [% ELSIF product.environmental_score_data.adjustments.packaging.value <= -5 %]
    "evaluation": "average",
    "title_element": {
        "title": [% lang('environmental_score_packaging_impact_medium') | js %]    ,
    [% ELSE %]
    "evaluation": "good",
    "title_element": {
        "title": [% lang('environmental_score_packaging_impact_low') | js %],
    [% END %]
        "subtitle": [% (lang('malus') _ sep _ ': ' _ product.environmental_score_data.adjustments.packaging.value) | js %],
        "icon_color_from_evaluation": true,
        "icon_url": "[% static_subdomain %]/images/icons/dist/packaging.svg",
        "icon_size": "small",
    },
    "elements": [
        {
            "element_type": "table",
            "table_element": {
                "id": "environmental_score_packaging_components",
                "title": [% lang('packaging_parts') | js %],
                "columns": [
                    {
                        "text": [% lang('packaging_shape') | js %],
                        "type": "text",
                    },
                    { 
                        "text": [% lang('packaging_material') | js %],
                        "type": "text",
                    },
                    { 
                        "text": [% lang('packaging_recycling') | js %],
                        "type": "text",
                    },
                    { 
                        "text": [% lang('environmental_score_impact') | js %],
                        "type": "text",
                    }
                ],
                "rows": [
                    [% FOREACH packaging IN product.environmental_score_data.adjustments.packaging.packagings %]
                    [% score = packaging.environmental_score_material_score; IF ! score.length; score = 0; END %]
                    {
                        "values": [
                            {
                                "text": "[% IF packaging.number_of_units %][% packaging.number_of_units %] [% END %][% display_taxonomy_tag_name('packaging_shapes',packaging.shape) %][% IF packaging.quantity %] ([% packaging.quantity %])[% END %]"
                            },
                            {
                                "text": "[% display_taxonomy_tag_name('packaging_materials',packaging.material) %]"
                            },
                            {
                                "text": "[% display_taxonomy_tag_name('packaging_recycling',packaging.recycling) %]",
                                [% IF packaging.recycling == "en:recycle" %]
                                    "evaluation": "good",
                                [% ELSIF packaging.recycling == "en:discard" %]
                                    "evaluation": "bad",
                                [% END %]
                            },
                            {
                            [% IF score >= 75 %]
                                "text": [% lang('low') | ucfirst | js %],
                                "evaluation": "good",
                            [% ELSIF score <= 25 %]
                                "text": [% lang('high') | ucfirst | js %],
                                "evaluation": "bad",
                            [% ELSE %]
                                "text": [% lang('medium') | ucfirst | js %],
                                "evaluation": "neutral",
                            [% END %]
                            }
                        ]
                    },
                    [% END %]
                ]
            }
        },
        [% IF product.environmental_score_data.adjustments.packaging.warning %]
        {
            "element_type": "text",
            "text_element": {
                "type": "warning",
                "html": `
                    [% lang('environmental_score_unprecise_packaging_information') %]
                    `
            }
        },         
        [% END %]
[% END %]           
        [% IF product.environmental_score_data.adjustments.packaging.warning %]
        {
            "element_type": "text",
            "text_element": {
                "type": "warning",
                "html": `
                [% lang('environmental_score_edit_for_more_precise_environmental_score') %]
                <br><br>
                [% lang('environmental_score_platform_prompt_environmental_score_modal') %]
                    `
            }
        },
        [% END %]
    ]
}
