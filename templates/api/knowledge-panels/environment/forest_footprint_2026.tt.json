{
    "level": "info",
    "topics": [
        "environment"
    ],
    "expanded": false,
    "title_element": {
        "name": [% lang('forest_footprint') | js %],
        "title": [% IF product.forest_footprint_2026.grade != 'unknown' && product.forest_footprint_2026.grade != 'not_computed' %][% lang("attribute_forest_footprint_${product.forest_footprint_2026.grade}_description_short") | js %][% ELSE %][% lang("attribute_forest_footprint_${product.forest_footprint_2026.grade}_title") | js %][% END %],
        "subtitle": [% lang("attribute_forest_footprint_${product.forest_footprint_2026.grade}_description") | js %],
        [% IF product.forest_footprint_2026.grade == 'not_computed' %]
        "icon_url": "[% static_subdomain %]/images/attributes/dist/forest-footprint-2026-white-bg-not-computed.svg",
        [% ELSE %]
        "icon_url": "[% static_subdomain %]/images/attributes/dist/forest-footprint-2026-white-bg-[% product.forest_footprint_2026.grade %].svg",
        [% END %]
        "type": "grade",
        "grade": "[% product.forest_footprint_2026.grade %]"
    },
    "elements": [
        {
            "element_type": "text",
            "text_element": {
                "type": "summary",
                "html": `
                <p><strong>[% lang('forest_footprint') %]</strong></p>
                <p>[% lang('forest_footprint_2026_methodology') %]
                &rarr; <a href="https://envol-vert.org/actu/2026/09/lempreinte-foret-sinvite-dans-les-telephones-des-francais/">[% lang('forest_footprint_2026_methodology_more_info') %]</a></p>

                [% IF product.forest_footprint_2026.grade == 'unknown' %]
                <p><strong>[% lang('attribute_forest_footprint_unknown_title') %]</strong></p>
                <p>[% lang('attribute_forest_footprint_unknown_description') %]</p>
                [% ELSIF product.forest_footprint_2026.grade == 'not_computed' %]
                <p><strong>[% lang('attribute_forest_footprint_not_computed_title') %]</strong></p>
                <p>[% lang('attribute_forest_footprint_not_computed_description') %]</p>
                [% ELSE %]
                <p><strong>[% lang('forest_footprint_2026_overall_grade') %][% sep %]:</strong> 
                    [% product.forest_footprint_2026.grade.ucfirst %]
                </p>
                <p>[% lang("attribute_forest_footprint_${product.forest_footprint_2026.grade}_description") %]</p>
                <p><strong>[% lang('total_forest_footprint') %][% sep %]:</strong> 
                    [% product.forest_footprint_2026.total_footprint_per_kg FILTER format("%.3f"); %] 
                    [% lang('square_meters_per_kg_of_food') %]
                </p>
                [% END %]
                `
            }
        },
        [% FOREACH primary_id IN ['en:cocoa', 'en:coffee', 'en:palm-oil'] %]
        [% IF product.forest_footprint_2026.primary_ingredients.${primary_id}.ingredients.defined && product.forest_footprint_2026.primary_ingredients.${primary_id}.ingredients.size %]
        [% SET primary = product.forest_footprint_2026.primary_ingredients.${primary_id} %]
        {
            "element_type": "text",
            "text_element": {
                "type": "summary",
                "html": `
                <h3>[% display_taxonomy_tag("ingredients", primary_id).ucfirst %]</h3>
                <p><strong>[% lang('forest_footprint_2026_primary_ingredient_grade') %][% sep %]:</strong> [% primary.grade.ucfirst %]</p>
                <p><strong>[% lang('forest_footprint_2026_primary_ingredient') %][% sep %]:</strong> [% primary.footprint_per_kg FILTER format("%.3f"); %] [% lang('square_meters_per_kg_of_food') %]</p>
                [% IF primary_id == 'en:cocoa' %]
                <p>[% lang('forest_footprint_2026_primary_ingredient_description_cocoa') %]</p>
                [% ELSIF primary_id == 'en:palm-oil' %]
                <p>[% lang('forest_footprint_2026_primary_ingredient_description_palm_oil') %]</p>
                [% ELSIF primary_id == 'en:coffee' %]
                <p>[% lang('forest_footprint_2026_primary_ingredient_description_coffee') %]</p>
                [% END %]
                `
            }
        },
        [% IF knowledge_panels_options.knowledge_panels_client == 'web' %]
        {
            "element_type": "table",
            "table_element": {
                "id": "forest_footprint_2026_[% primary_id %]_table",
                "title": "[% display_taxonomy_tag("ingredients", primary_id) %]",
                "columns": [
                    {
                        "text": [% lang('ingredients_s') | ucfirst | js %],
                        "type": "text"
                    },
                    {
                        "text": [% lang('percent_in_product') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% lang('forest_footprint_2026_primary_ingredient') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% lang('processing_factor') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% lang('origin') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% lang('forest_footprint_2026_origin_footprint') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% lang('forest_footprint_2026_label') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% lang('deforestation_risk') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% (lang('forest_footprint') _ '<br><span style="font-weight:normal">(' _ lang('square_meters_per_kg_of_food') _ ')</span>') | js %],
                        "type": "text"
                    },
                ],
                "rows": [
                    [% FOREACH ingredient IN primary.ingredients %]
                    {
                        "values": [
                            {
                                "text": "[% display_taxonomy_tag("ingredients", ingredient.ingredient_id) %]"
                            },
                            {
                                "text": "[% ingredient.percent FILTER format("%.2f"); %] %"
                            },
                            {
                                "text": "[% display_taxonomy_tag("ingredients", ingredient.primary_ingredient_id) %]"
                            },
                            {
                                "text": "[% ingredient.transformation_factor FILTER format("%.2f"); %]"
                            },
                            {
                                "text": "[% display_taxonomy_tag("origins", ingredient.origin_id) %]"
                            },
                            {
                                "text": "[% ingredient.origin_footprint FILTER format("%.3f"); %]"
                            },
                            {
                                "text": "[% IF ingredient.label_id.defined %][% display_taxonomy_tag("labels", ingredient.label_id) %][% ELSE %]-[% END %]"
                            },
                            {
                                "text": "[% ingredient.risk_factor * 100 FILTER format("%.0f"); %] %"
                            },
                            {
                                "text": "[% ingredient.footprint_per_kg FILTER format("%.3f"); %]"
                            },
                        ]
                    }[% UNLESS loop.last %],[% END %]
                    [% END %]
                ]
            }
        },
        [% END %]
        [% END %]
        [% END %]
        [% FOREACH primary_id IN ['en:chicken-and-eggs'] %]
        [% IF product.forest_footprint_2026.primary_ingredients.${primary_id}.ingredients.defined && product.forest_footprint_2026.primary_ingredients.${primary_id}.ingredients.size %]
        [% SET primary = product.forest_footprint_2026.primary_ingredients.${primary_id} %]
        {
            "element_type": "text",
            "text_element": {
                "type": "summary",
                "html": `
                <h3>[% lang("ingredients_requiring_soy") %]</h3>
                <p>[% lang("forest_footprint_one_line_explanation") %]</p>
                <p><strong>[% lang('forest_footprint_2026_primary_ingredient_grade') %][% sep %]:</strong> [% primary.grade.ucfirst %]</p>
                <p><strong>[% lang('total_forest_footprint') %][% sep %]:</strong> [% primary.footprint_per_kg FILTER format("%.3f"); %] [% lang('square_meters_per_kg_of_food') %]</p>
                <p>[% lang('forest_footprint_2026_primary_ingredient_description_chicken_and_eggs') %]</p>
                `
            }
        },
        [% IF knowledge_panels_options.knowledge_panels_client == 'web' %]
        {
            "element_type": "table",
            "table_element": {
                "id": "forest_footprint_2026_[% primary_id %]_table",
                "title": "[% display_taxonomy_tag("ingredients", primary_id) %]",
                "columns": [
                    {
                        "text": [% lang('ingredients_s') | ucfirst | js %],
                        "type": "text"
                    },
                    {
                        "text": [% lang("type") | js %],
                        "type": "text"
                    },
                    {
                        "text": [% lang("percent_in_product") | js %],
                        "type": "text"
                    },
                    {
                        "text": [% (lang("processing_factor") _ '<br><span style="font-weight:normal">(' _ lang("percent_of_food_after_processing") _ ')</span>') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% (lang("soy_feed_factor") _ '<br><span style="font-weight:normal">(' _ lang("kg_of_soy_per_kg_of_food") _ ')</span>') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% (lang("soy_yield") _ '<br><span style="font-weight:normal">(' _ lang("kg_of_soy_per_square_meter") _ ')</span>') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% (lang("deforestation_risk") _ '<br><span style="font-weight:normal">(%)</span>') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% (lang("forest_footprint") _ '<br><span style="font-weight:normal">(' _ lang("square_meters_per_kg_of_food") _ ')</span>') | js %],
                        "type": "text"
                    }
                ],
                "rows": [
                    [% FOREACH ingredient IN primary.ingredients %]
                    {
                        "values": [
                            {
                                "text": "[% display_taxonomy_tag(ingredient.tag_type, ingredient.tag_id) %]"
                            },
                            {
                                "text": "[% ingredient.type.name %]"
                            },
                            {
                                "text": "[% ingredient.percent FILTER format("%.2f"); %] %"
                            },
                            {
                                "text": "[% ingredient.processing_factor * 100 FILTER format("%d"); %] %"
                            },
                            {
                                "text": "[% ingredient.type.soy_feed_factor %]"
                            },
                            {
                                "text": "[% ingredient.type.soy_yield %]"
                            },
                            {
                                "text": "[% ingredient.type.deforestation_risk * 100 FILTER format("%d"); %] %"
                            },
                            {
                                "text": "[% ingredient.footprint_per_kg FILTER format("%.3f"); %]"
                            }
                        ]
                    }[% UNLESS loop.last %],[% END %]
                    [% END %]
                ]
            }
        },
        [% END %]
        [% END %]
        [% SET other_risky_ingredients = "en:other-risky-ingredients" %]
        [% IF product.forest_footprint_2026.primary_ingredients.$other_risky_ingredients.defined && product.forest_footprint_2026.primary_ingredients.$other_risky_ingredients.ingredients.defined && product.forest_footprint_2026.primary_ingredients.$other_risky_ingredients.ingredients.size %]
        {
            "element_type": "text",
            "text_element": {
                "type": "summary",
                "html": `
                <h3>[% lang('forest_footprint_2026_other_risky_ingredients') %]</h3>
                <p>[% lang('forest_footprint_2026_other_risky_ingredients_description') %]</p>
                <ul>
                [% FOREACH ingredient IN product.forest_footprint_2026.primary_ingredients.$other_risky_ingredients.ingredients %]
                <li>[% display_taxonomy_tag("ingredients", ingredient.ingredient_id) %]</li>
                [% END %]
                </ul>
                `
            }
        },       
        [% END %]
        [% IF product.forest_footprint_2026.grade != "unknown" && product.forest_footprint_2026.grade != "not_computed" %]
        {
            "element_type": "text",
            "text_element": {
                "type": "summary",
                "html": `
                <h3>[% lang('labels_p').ucfirst  %]</h3>
                <p>[% lang('forest_footprint_2026_labels_description') %]</p>
                `
            }
        },
        [% END %]
        [% END %]
    ]
}
