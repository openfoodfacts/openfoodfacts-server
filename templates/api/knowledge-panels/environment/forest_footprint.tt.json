{
    "level": "info",
    "topics": [
        "environment"
    ],
    "title_element": {
        "name": [% lang('forest_footprint') | js %],
        "title": [% lang("attribute_forest_footprint_${product.forest_footprint_data.grade}_title") | js %],
        "subtitle": [% lang("attribute_forest_footprint_${product.forest_footprint_data.grade}_description_short") | js %]        ,
        "icon_url": "[% static_subdomain %]/images/attributes/dist/forest-footprint-[% product.forest_footprint_data.grade %].svg",
        "type": "grade",
        "grade": "[% product.forest_footprint_data.grade %]"        
    },
    "elements": [
        {
            "element_type": "text",
            "text_element": {
                "type": "summary",
                "html": `
                <p><strong>[% lang("ingredients_requiring_soy") %]</strong></p>
                <p>[% lang("forest_footprint_one_line_explanation") %]</p>
                `
            }
        },
        [% IF product.forest_footprint_data.ingredients.defined && product.forest_footprint_data.ingredients.size %]
        {
            "element_type": "table",
            "table_element": {
                "id": "forest_footprint_table",
                "title": [% lang("ingredients_requiring_soy") | js %],
                "columns": [
                    {
                        "text": [% lang("ingredients_s") | ucfirst | js %],
                        "type": "text"
                    },
                    {
                        "text": [% lang("type") | js %],
                        "type": "text"
                    },
                    {
                        "text": [% lang("percent_in_product") | js %],
                        "type": "text"
                    },
                    {
                        "text": [% (lang("processing_factor") _ '<br><span style="font-weight:normal">(' _ lang("percent_of_food_after_processing") _ ')</span>') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% (lang("soy_feed_factor") _ '<br><span style="font-weight:normal">(' _ lang("kg_of_soy_per_kg_of_food") _ ')</span>') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% (lang("soy_yield") _ '<br><span style="font-weight:normal">(' _ lang("kg_of_soy_per_square_meter") _ ')</span>') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% (lang("deforestation_risk") _ '<br><span style="font-weight:normal">(%)</span>') | js %],
                        "type": "text"
                    },
                    {
                        "text": [% (lang("forest_footprint") _ '<br><span style="font-weight:normal">(' _ lang("square_meters_per_kg_of_food") _ ')</span>') | js %],
                        "type": "text"
                    }
                ],
                "rows": [
                    [% FOREACH ingredient IN product.forest_footprint_data.ingredients %]
                    {
                        "values": [
                            {
                                "text": "[% display_taxonomy_tag(ingredient.tag_type, ingredient.tag_id) %]"
                            },
                            {
                                "text": "[% ingredient.type.name %]"
                            },
                            {
                                "text": "[% ingredient.percent FILTER format("%.2f"); %] %"
                            },
                            {
                                "text": "[% ingredient.processing_factor * 100 FILTER format("%d"); %] %"
                            },
                            {
                                "text": "[% ingredient.type.soy_feed_factor %]"
                            },
                            {
                                "text": "[% ingredient.type.soy_yield %]"
                            },
                            {
                                "text": "[% ingredient.type.deforestation_risk * 100 FILTER format("%d"); %] %"
                            },
                            {
                                "text": "[% ingredient.footprint_per_kg FILTER format("%.2f"); %]"
                            }
                        ]
                    }[% UNLESS loop.last %],[% END %]
                    [% END %]
                ]
            }
        },
        [% END %]
        {
            "element_type": "text",
            "text_element": {
                "type": "summary",
                "html": `
                    <h3>[% lang("total_forest_footprint") %]</h3>
                    <p><strong>[% product.forest_footprint_data.footprint_per_kg FILTER format("%.2f"); %] [% lang("square_meters_per_kg_of_food") %]</strong></p>
                `
            }
        }
    ]
}