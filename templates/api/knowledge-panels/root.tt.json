{
    "type": "root",
    "expanded": true,
    "elements": [
        [% IF knowledge_panels_options.activate_knowledge_panels_ingredients_nutrition_first %]
        [% IF panels.ingredients_card.defined %]
        {
            "element_type": "panel",
            "panel_element": {
                "panel_id": "ingredients_card",
            },
        },
        [% END %]
        [% IF panels.nutrition_card.defined %]
        {
            "element_type": "panel",
            "panel_element": {
                "panel_id": "nutrition_card",
            },
        },
        [% END %]
        [% END %]
        [% IF panel.has_health_card %]
        {
            "element_type": "panel",
            "panel_element": {
                "panel_id": "health_card",
            },
        },
        [% END %]
        [% IF panel.has_environment_card %]
        {
            "element_type": "panel",
            "panel_element": {
                "panel_id": "environment_card",
            },
        },
        [% END %]
        [% IF panel.has_maintain_card %]
        {
            "element_type": "panel",
            "panel_element": {
                "panel_id": "maintain_card",
            },
        },
        [% END %]
        [% IF panel.has_reuse_card %]
        {
            "element_type": "panel",
            "panel_element": {
                "panel_id": "reuse_card",
            },
        },
        [% END %]
        [% IF panel.has_secondhand_card %]
        {
            "element_type": "panel",
            "panel_element": {
                "panel_id": "secondhand_card",
            },
        },
        [% END %]       
        [% IF panel.has_product_card AND knowledge_panels_options.activate_knowledge_panels_ingredients_nutrition_first %]
        {
            "element_type": "panel",
            "panel_element": {
                "panel_id": "product_card",
            },
        },
        [% END %]
        [% IF panel.has_report_problem_card %]
        {
            "element_type": "panel",
            "panel_element": {
                "panel_id": "report_problem_card",
            },
        },
        [% END %]
        [% IF panel.has_contribution_card %]
            {
                "element_type": "panel",
                "panel_element": {
                    "panel_id": "contribution_card",
                },
            },
        [% END %]
        [% IF panel.has_product_card AND NOT knowledge_panels_options.activate_knowledge_panels_ingredients_nutrition_first %]
        {
            "element_type": "panel",
            "panel_element": {
                "panel_id": "product_card",
            },
        },
        [% END %]
    ],
}
