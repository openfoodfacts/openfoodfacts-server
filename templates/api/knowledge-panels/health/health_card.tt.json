{
    "type": "card",
    [% IF knowledge_panels_options.activate_knowledge_panels_ingredients_nutrition_first %]
    "expanded": false,
    [% ELSE %]
    "expanded": true,
    [% END %]
    "topics": [
        "health"
    ],
    "title_element": {
        "title": "[% edq(lang('health')) %]",
        [% IF knowledge_panels_options.activate_knowledge_panels_ingredients_nutrition_first %]
        [% summary = [] %]
        [% FOREACH panel_id IN ['nutriscore_2023', 'nova'] %]
            [% IF panels.$panel_id.title_element.title %][% summary.push(panels.$panel_id.title_element.title) %][% END %]
        [% END %]
        [% IF summary.size %]
        "subtitle": "[% edq(summary.join(' - ')) %]",
        [% END %]
        [% END %]
    },    
    "elements": [
        [% IF panels.recommendation_health.defined %]
        {
            "element_type": "panel",
            "panel_element": {
                "panel_id": "recommendation_health",
            },
        },
        [% END %]

        [% IF panels.recommendation_health2.defined %]
        {
            "element_type": "panel",
            "panel_element": {
                "panel_id": "recommendation_health2",
            },
        },
        [% END %]        

        [% IF knowledge_panels_options.activate_knowledge_panels_ingredients_nutrition_first %]

            [%# ingredients and nutrition facts have their own cards, the Nutri-Score stays here %]
            [% IF feature_enabled("nutrition") AND (panels.nutriscore_2023.defined OR panels.nutriscore.defined) %]
            {
                "element_type": "panel_group",
                "panel_group_element": {
                    "title": "",
                    "panel_ids": [
                        [% IF panels.nutriscore_2023.defined %]
                            "nutriscore_2023",
                        [% END %]
                        [% IF panels.nutriscore.defined %]
                            "nutriscore",
                        [% END %]
                    ],
                },
            },
            [% END %]
            [% IF feature_enabled("ingredients") %]
                [% INCLUDE "api/knowledge-panels/health/ingredients_panels.tt.json" %]
            [% END %]

        [% ELSIF knowledge_panels_options.knowledge_panels_client == 'disabled-web' %]

            [% IF feature_enabled("ingredients") %]
                [% INCLUDE "api/knowledge-panels/health/ingredients_panels.tt.json" %]
            [% END %]
            [% IF feature_enabled("nutrition") %]
                [% INCLUDE "api/knowledge-panels/health/nutrition_panels.tt.json" %]
            [% END %]

        [% ELSE %]

            [% IF feature_enabled("nutrition") %]
                [% INCLUDE "api/knowledge-panels/health/nutrition_panels.tt.json" %]
            [% END %]
            [% IF feature_enabled("ingredients") %]
                [% INCLUDE "api/knowledge-panels/health/ingredients_panels.tt.json" %]
            [% END %]
        [% END %]
    ],
}
