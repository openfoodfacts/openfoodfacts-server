[%# A panel with information useful to contributors %]
{
    "type": "card",
    "expanded": true,
    "topics": [
        "contribution"
    ],
    "title_element": {
        "title": [% lang('contribution_panel_title') | js %],
    },
    "elements": [
        [%# Panels displaying data_quality errors / warnings / info, and the product history %]
        [% FOREACH panel_name IN panel.contribution_panels %]
        {
            "element_type": "panel",
            "panel_element": {
                "panel_id": [% panel_name | js %],
            },
        },
        [% END %]
    ],
}