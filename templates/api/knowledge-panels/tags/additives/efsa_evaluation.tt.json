{
    "level" :"info",
    "topics": [
        "additives"
    ],
    "title_element": {
        [% IF panel.risk %]
        "icon_url": "[% static_subdomain %]/images/misc/additives-efsa-evaluation-overexposure-risk-icon-[% panel.risk %].svg",
        [% END %]
        "title": "[% edq(lang('additives_efsa_evaluation')) %]",
    },
    "expanded": true,
    "elements": [
        [% IF panel.risk %]
        {
            "element_type": "text",
            "text_element": {
                "html": `<p>[% lang("additives_efsa_evaluation_overexposure_risk_${panel.risk}").replace('<tag>', display_taxonomy_tag_name("additives", panel.additive_id)) %]</p>
[%- FOREACH exposure IN panel.exposures %]
<p><strong>[% lang("additives_${exposure.id}") %]</strong>[% sep %]: [% FOREACH group IN exposure.groups %][% lang(group) %][% IF NOT loop.last %], [% END %][% END %]</p>
[%- END %]`
            }
        },
        [% END %]
        [% IF panel.evaluation %]
        {
            "element_type": "text",
            "text_element": {
                "html": `<p>[% panel.evaluation %][% IF panel.evaluation_date %] ([% panel.evaluation_date %])[% END %]</p>`,
                [% IF panel.evaluation_url %]
                "source_text": "EFSA",
                "source_url": "[% panel.evaluation_url %]",
                [% END %]
            }
        },
        [% END %]
    ]
}
