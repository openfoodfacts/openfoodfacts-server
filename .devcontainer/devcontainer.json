{
  "name": "Perl",
  "initializeCommand": "make run_deps",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker/dev.yml",
    "../docker/run.yml",
    "../docker/devcontainer.yml"
  ],
  "containerEnv": {
    "HOME": "/tmp"
  },
  "capAdd": [
    "SYS_PTRACE"
  ],
  "securityOpt": [
    "seccomp=unconfined"
  ],
  "service": "backend",
  "runServices": [
    "memcached",
    "postgres",
    "dynamicfront",
    "frontend",
    "incron",
    "minion",
    "redis-listener"
  ],
  "workspaceFolder": "/opt/product-opener",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash",
        // perl-lsp is baked into the backend image (see Dockerfile);
        // use it instead of the extension's auto-downloaded binary.
        "perl-lsp.path": "/usr/local/bin/perl-lsp",
        // The perlcritic language server pipes buffer text via stdin from its
        // own cwd, so it never finds ./.perlcriticrc on its own (and then
        // reports default-profile violations our config disables). Passing
        // --profile both pins our repo config and stops the extension from
        // appending --gentle (see its mergeSettings).
        "perlcritic.additionalArguments": [
          "--profile",
          "/opt/product-opener/.perlcriticrc"
        ],
        // The perltidy VS Code extension pipes buffer text via stdin with the
        // file's directory as cwd, so without an explicit profile the repo's
        // .perltidyrc (repo root) is never found and defaults reformat code
        // away from `make check_perltidy`. Pin the absolute profile instead.
        "perltidy-more.profile": "/opt/product-opener/.perltidyrc"
      },
      "extensions": [
        "tree-sitter-perl.vscode-perl-lsp",
        "Nihilus118.perl-debugger",
        "kaktus.perltidy-more",
        "sfodje.perlcritic",
        "redhat.vscode-yaml",
        "dbaeumer.vscode-eslint",
        "stylelint.vscode-stylelint",
        "syler.sass-indented",
        "mrorz.language-gettext",
        "SonarSource.sonarlint-vscode",
        "codecov.codecov"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1":{},
    "ghcr.io/devcontainers/features/github-cli:1":{},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "libterm-readline-gnu-perl"
    }
  }
}
