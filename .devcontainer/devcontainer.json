{
  "name": "Perl",
  "initializeCommand": "make run_deps",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker/dev.yml",
    "../docker/run.yml",
    "../docker/devcontainer.yml"
  ],
  "containerEnv": {
    "HOME": "/tmp",
    "PO_AGENT_ID": "${localEnv:PO_AGENT_ID}",
    "PO_AGENT_PREFIX": "${localEnv:PO_AGENT_PREFIX}",
    "PO_AGENT_SUFFIX": "${localEnv:PO_AGENT_SUFFIX}",
    "COMPOSE_PROJECT_NAME": "${localEnv:COMPOSE_PROJECT_NAME}",
    "PRODUCT_OPENER_DOMAIN": "${localEnv:PRODUCT_OPENER_DOMAIN}",
    "PRODUCT_OPENER_HOST_PORT": "${localEnv:PRODUCT_OPENER_HOST_PORT}",
    "PRODUCT_OPENER_PORT": "${localEnv:PRODUCT_OPENER_PORT}",
    "PRODUCT_OPENER_NETWORK": "${localEnv:PRODUCT_OPENER_NETWORK}",
    "COMMON_NET_NAME": "${localEnv:COMMON_NET_NAME}",
    "MINION_QUEUE": "${localEnv:MINION_QUEUE}"
  },
  "capAdd": [
    "SYS_PTRACE"
  ],
  "securityOpt": [
    "seccomp=unconfined"
  ],
  "service": "backend",
  "runServices": [
    "memcached",
    "postgres",
    "dynamicfront",
    "frontend",
    "incron",
    "minion",
    "redis-listener",
    "keycloak"
  ],
  "workspaceFolder": "/opt/product-opener",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "richterger.perl",
        "d9705996.perl-toolbox",
        "redhat.vscode-yaml",
        "dbaeumer.vscode-eslint",
        "stylelint.vscode-stylelint",
        "syler.sass-indented",
        "mrorz.language-gettext",
        "SonarSource.sonarlint-vscode",
        "codecov.codecov"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1":{},
    "ghcr.io/devcontainers/features/github-cli:1":{},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "libterm-readline-gnu-perl"
    }
  }
}