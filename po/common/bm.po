msgctxt "site_description_opf"
msgid "A collaborative, free and open database of information on various products from around the world."
msgstr "Kunnafoni minnu bɛ sɔrɔ jɛ-ka-baara, fu ani da wulilen na, minnu bɛ sɔrɔ fɛn suguya caman kan minnu bɛ bɔ diɲɛ fan bɛɛ la."

