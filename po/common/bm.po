msgid "Hazardous food additive. Avoid."
msgstr "Dumunifɛn faralifɛn faratiman. Y'i mabɔ a la."

msgctxt "additives_3"
msgid "Food additive banned in Europe. Avoid at all cost."
msgstr "Dumunifɛn faralifɛn gɛlɛyalen Tugalajamana la. Y'i mabɔ a la pewu."

