msgid "/open-food-facts-mobile-app"
msgstr "/open-food-facts-mobile-app"

msgctxt "product_description_off"
msgid "Ingredients, allergens, additives, nutrition facts, labels, origins, CO2 impact and information on product %s"
msgstr "Fɛn minnu bɛ kɛ ka a furakɛ, faritanabanakisɛw, faralifɛnw, balocogo tiɲɛnenw, sɛbɛnw, bɔyɔrɔ, CO2 nɔfɛkow ani kunnafoni minnu bɛ fura kan %s"

msgctxt "site_description_obf"
msgid "A collaborative, free and open database of ingredients, and information on cosmetic products from around the world"
msgstr "Baarakɛɲɔgɔnya, fu ani da wulilen kunnafonidilan min bɛ fɛnw jira, ani kunnafoniw minnu bɛ ɲɛgɛnw kan ka bɔ diɲɛ fan bɛɛ la"

msgctxt "tagline_obf"
msgid "Open Beauty Facts gathers information and data on cosmetic products from around the world."
msgstr "Open Beauty Facts bɛ kunnafoniw ni kunnafoniw lajɛ ɲɛgɛnw kan ka bɔ diɲɛ fan bɛɛ la."

msgctxt "footer_tagline_obf"
msgid "A collaborative, free and open database of cosmetic products from around the world."
msgstr "Baarakɛɲɔgɔnya, fu ani da wulilen kunnafonisɛbɛn min bɛ ɲɛgɛnw dilan ka bɔ diɲɛ fan bɛɛ la."

msgctxt "product_description_obf"
msgid "Ingredients INCI, allergens, additives, labels, origin of ingredients and information on product %s"
msgstr "Fɛn minnu bɛ kɛ INCI, faritanabana furaw, faralifɛnw, taamasiɲɛw, fɛnw bɔyɔrɔ ani kunnafoni minnu bɛ fura kan %s"

